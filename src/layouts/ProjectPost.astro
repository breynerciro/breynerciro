---
import type { Locale } from '../i18n/locales';
import { t, localizedHref } from '../i18n/utils';
import { slugFromId } from '../utils/content';
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import BaseLayout from './BaseLayout.astro';

interface Props {
  entry: CollectionEntry<'projects'>;
  locale: Locale;
}

const { entry, locale } = Astro.props;
const translate = t(locale);
const { Content } = await render(entry);
const { data } = entry;
const links = [
  data.repoUrl && { label: translate('projects.viewCode'), url: data.repoUrl },
  ...data.extraRepos.map((r) => ({ label: `${translate('projects.viewCode')} · ${r.label}`, url: r.url })),
  data.demoUrl && { label: translate('projects.viewLive'), url: data.demoUrl },
].filter(Boolean) as { label: string; url: string }[];
---

<BaseLayout
  locale={locale}
  title={`${data.title} — Breyner Ciro`}
  description={data.description}
  canonicalPath={`/projects/${slugFromId(entry.id)}/`}
>
  <article class="py-16 font-mono">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <a
        href={localizedHref(locale, '/#projects')}
        class="mb-8 inline-block text-sm text-[#94a3b8] transition-colors hover:text-[#4ade80]"
      >
        {translate('projects.back')}
      </a>

      <header class="mb-10">
        <h1 class="mb-4 text-3xl font-extrabold text-[#f1f5f9] sm:text-4xl">{data.title}</h1>
        <p class="mb-5 text-sm leading-relaxed text-[#94a3b8]">{data.description}</p>
        <ul class="mb-5 flex flex-wrap gap-1.5">
          {data.stack.map((s) => (
            <li class="border border-[#1e2d1e] bg-[#0d0d0d] px-2 py-0.5 text-xs text-[#94a3b8]">{s}</li>
          ))}
        </ul>
        {links.length > 0 && (
          <div class="flex flex-wrap gap-3 text-sm">
            {links.map((l) => (
              <a
                href={l.url}
                target="_blank"
                rel="noopener noreferrer"
                class="border border-[#4ade80] px-4 py-2 font-bold text-[#4ade80] transition-all hover:bg-[#4ade80] hover:text-black"
              >
                {l.label} ↗
              </a>
            ))}
          </div>
        )}
      </header>

      <div class="prose prose-neutral dark:prose-invert max-w-none">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>
