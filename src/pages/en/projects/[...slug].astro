---
import type { GetStaticPaths } from 'astro';
import ProjectPost from '../../../layouts/ProjectPost.astro';
import { getLocalized, slugFromId } from '../../../utils/content';

export const getStaticPaths = (async () => {
  const projects = await getLocalized('projects', 'en');
  return projects.map((p) => ({
    params: { slug: slugFromId(p.id) },
    props: { entry: p },
  }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
---

<ProjectPost entry={entry} locale="en" />
