---
import { type Locale } from '../../i18n/locales';
import { t } from '../../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const translate = t(locale);

const stats = [
  { value: '4+', key: 'about.stat experience' },
  { value: '3', key: 'about.stat projects' },
  { value: '−50%', key: 'about.stat clients' },
];
---

<section id="about" class="scroll-mt-20 py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">

    <!-- Section header -->
    <div class="mb-12 font-mono">
      <p class="mb-1 text-xs text-[#94a3b8]">
        <span class="text-[#4ade80]">breynerciro@portfolio</span><span class="text-[#94a3b8]">:~$</span>
      </p>
      <h2 class="text-3xl font-bold text-[#f1f5f9] sm:text-4xl">
        <span class="text-[#4ade80]">./whoami</span>
        <span class="animate-[blink_1.2s_step-end_infinite] text-[#4ade80]">▋</span>
      </h2>
      <p class="mt-1 text-xs text-[#94a3b8]">// {translate('about.title')}</p>
    </div>

    <div class="grid gap-8 lg:grid-cols-5">

      <!-- Text content — terminal window -->
      <div class="terminal-window lg:col-span-3">
        <div class="terminal-header">
          <div class="flex gap-1.5">
            <span class="terminal-dot dot-red"></span>
            <span class="terminal-dot dot-yellow"></span>
            <span class="terminal-dot dot-green"></span>
          </div>
          <span class="ml-2 text-xs font-mono text-[#94a3b8]">~/about/README.md</span>
        </div>
        <div class="p-6">
          <p class="mb-4 font-mono text-xs text-[#94a3b8]">
            <span class="text-[#4ade80]">$</span> cat README.md
          </p>
          <p class="mb-4 text-sm leading-7 text-[#cbd5e1]">
            {translate('about.p1')}
          </p>
          <p class="text-sm leading-7 text-[#cbd5e1]">
            {translate('about.p2')}
          </p>
        </div>
      </div>

      <!-- Stats -->
      <div class="flex flex-col gap-4 lg:col-span-2">
        {stats.map((stat) => (
          <div class="terminal-window group transition-all hover:border-[#276749]">
            <div class="terminal-header">
              <div class="flex gap-1.5">
                <span class="terminal-dot dot-red"></span>
                <span class="terminal-dot dot-yellow"></span>
                <span class="terminal-dot dot-green"></span>
              </div>
              <span class="ml-2 text-xs font-mono text-[#94a3b8]">stat.log</span>
            </div>
            <div class="p-5 font-mono">
              <div class="text-4xl font-extrabold text-[#4ade80]">{stat.value}</div>
              <div class="mt-2 text-xs text-[#94a3b8]">
                <span class="text-[#4ade80]">// </span>{translate(stat.key)}
              </div>
            </div>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>

<style>
  @keyframes blink {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0; }
  }
</style>
